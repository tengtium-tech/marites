{
  "name": "@marites/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "generate:types": "openapi-typescript ../../docs/07-data-and-contracts/openapi/openapi.yaml -o src/api/generated/openapi.d.ts",
    "generate:client": "orval --config ./orval.config.mjs",
    "generate:api": "npm run generate:types && npm run generate:client",
    "typecheck": "tsc --noEmit",
    "verify:query-compat": "node ../../tests/contract-compat/verify-query-output.mjs && tsc --noEmit",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.9.5",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.0",
    "autoprefixer": "^10.4.20",
    "openapi-typescript": "7.13.0",
    "orval": "8.47.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.3",
    "vite": "7.2.0"
  }
}
