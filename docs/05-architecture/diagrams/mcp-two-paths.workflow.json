  "cards": [
    {
      "dot": "cyan",
      "title": "Attribution",
      "items": [
        "Direct execution records the human behind the credential as actor and Claude as the channel; the assistant is never the actor.",
        "The proposal path records the human confirmer in approvedBy and retains proposalId."
      ]
    },
    {
      "dot": "amber",
      "title": "Proposal guard",
      "items": [
        "A pending proposal expires after a bounded window (one hour by default); stale work must be proposed again.",
